    "title": {
      "path": "title"
    },
    "description": {
      "path": "excerpt"
    },
    "category": {
      "path": "categories.0.name",
      "default": "Kultur"
    },
    "organizer": {
      "default": "Brotfabrik Berlin"
    },
    "url": {
      "path": "url"
    },
    "locationName": {
      "path": "venue.venue",
      "default": "Brotfabrik"
    },
    "locationAddress": {
      "default": "Caligariplatz 1, 13086 Berlin",
      "template": "{venue.address}, {venue.zip} {venue.city}"
    },
    "start": {
      "path": "start_date",
      "format": "2006-01-02 15:04:05"
    },
    "end": {
      "path": "end_date",
      "format": "2006-01-02 15:04:05"
    },
    "price": {
      "amountPath": "cost_details.values.0",
      "unknownIfMissing": true
    }
  },
  "daysAhead": 30,
  "categoryMap": {
    "Ausstellung": "Kunst",
    "Bühne": "Theater",
