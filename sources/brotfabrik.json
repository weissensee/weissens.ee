{
  "label": "Brotfabrik",
  "homepage": "https://brotfabrik-berlin.de",
  "type": "json",
  "images": true,
  "url": "https://brotfabrik-berlin.de/wp-json/tribe/events/v1/events?per_page=50",
  "itemsPath": "events",
  "nextPath": "next_rest_url",
